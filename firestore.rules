rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function authEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function normalizedEmail() {
      let email = authEmail();
      return email == '' ? '' : email.lower();
    }

    function adminRecordExists() {
      return isAuthenticated() && (
        (normalizedEmail() != '' && exists(/databases/$(database)/documents/admins/$(normalizedEmail()))) ||
        (authEmail() != '' && authEmail() != normalizedEmail() && exists(/databases/$(database)/documents/admins/$(authEmail())))
      );
    }

    function isAdminUserProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin';
    }

    function isLeadAdmin() {
      return normalizedEmail() == 'rajkumarbalu81@gmail.com';
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isLeadAdmin() || adminRecordExists() || isAdminUserProfile();
    }

    function sellerOwnsData(data) {
      return isAuthenticated() && data.sellerId == request.auth.uid;
    }

    function sellerOwnsRequestData() {
      return isAuthenticated() && request.resource != null &&
        request.resource.data.sellerId == request.auth.uid;
    }

    function sellerCreatesAdminNotification() {
      return sellerOwnsRequestData() &&
        request.resource.data.audience == 'admin' &&
        request.resource.data.type == 'support' &&
        request.resource.data.ticketId != null;
    }

    function sellerIsVerified() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.verified == true ||
          get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved' ||
          (
            exists(/databases/$(database)/documents/sellerVerification/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/sellerVerification/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    function notificationAudienceAllowed(audience) {
      return audience == 'all' ||
        audience == 'seller' ||
        audience == 'buyer' ||
        audience == ('user:' + request.auth.uid) ||
        audience == ('seller:' + request.auth.uid) ||
        (audience == 'admin' && isAdmin());
    }
    
    // Admins collection - only admins can read, no writes from client
    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if isLeadAdmin();
    }

    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isLeadAdmin();
    }
    
    // Users collection - users can read/write their own documents, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Admins can update user status
    }
    
    // Sellers collection - sellers can read/write their own documents
    function sellerOwnerSafeUpdate(sellerId) {
      return isOwner(sellerId) && resource != null &&
        !request.resource.data.diff(resource.data).changedKeys()
          .hasAny(['verified', 'status', 'approvedAt', 'approvedBy', 'approvalNotes']);
    }

    match /sellers/{sellerId} {
      // Any authenticated user can check if they are a seller
      allow read: if isOwner(sellerId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == sellerId &&
        (!request.resource.data.keys().hasAny(['verified', 'status']) || request.resource.data.verified == false);
      allow update: if isAdmin() || sellerOwnerSafeUpdate(sellerId);
      allow delete: if isAdmin();
    }
    
    // Products collection - anyone can read, sellers can write their own
    match /products/{productId} {
      allow read: if true;
      allow create: if sellerOwnsRequestData() && sellerIsVerified();
      allow update: if ((sellerOwnsData(resource.data) && sellerOwnsRequestData() && sellerIsVerified()) || isAdmin());
      allow delete: if sellerOwnsData(resource.data) || isAdmin();
    }
    
    // Orders collection - admins can read all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || 
         resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid ||
         resource.data.userId == request.auth.uid);
    }
    
    // Seller Services collection
    match /sellerServices/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId) || isAdmin();
    }
    
    // Seller Verification collection - sellers can submit, admins can read/update
    match /sellerVerification/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create, update: if isOwner(sellerId);
      allow update: if isAdmin(); // Admins can approve/reject
    }

    // Service verification submissions
    match /serviceVerifications/{submissionId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsRequestData();
      allow update, delete: if isAdmin() || (sellerOwnsData(resource.data) && !request.resource.data.keys().hasAny(['status', 'adminNote', 'reviewerEmail', 'reviewedAt']));
    }

    // Seller support tickets
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsRequestData() && 
        request.resource.data.status == 'open' &&
        request.resource.data.subject != null &&
        request.resource.data.description != null;
      allow update: if isAdmin() || (sellerOwnsData(resource.data) && !request.resource.data.keys().hasAny(['status', 'adminNote', 'adminEmail', 'lastActor']));
      allow delete: if isAdmin();
    }

    // Notifications collection - targeted notifications for users/sellers/admins
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && notificationAudienceAllowed(resource.data.audience);
      allow create: if isAdmin() || sellerCreatesAdminNotification();
      allow update, delete: if isAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if isAdmin() || isLeadAdmin();
      allow write: if isLeadAdmin();
    }

    // Transactions collection - sellers and admins only
    match /transactions/{transactionId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow write: if false; // Managed via backend processes
    }

    // Withdrawals collection - sellers can create/read their own, admins manage
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsData(request.resource.data);
      allow update: if isAdmin() || sellerOwnsData(resource.data);
    }
    
    // General read access for public data
    match /categories/{document=**} {
      allow read: if true;
    }

    // Promotions/Offers collection - sellers manage their own, public read for active
    match /promotions/{promotionId} {
      allow read: if true; // Public can see active promotions
      allow create: if sellerOwnsRequestData() && sellerIsVerified();
      allow update: if (sellerOwnsData(resource.data) && sellerOwnsRequestData()) || isAdmin();
      allow delete: if sellerOwnsData(resource.data) || isAdmin();
    }

    // Loyalty transactions - user can read own, write via Cloud Functions only
    match /loyaltyTransactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Loyalty points summary per user
    match /loyaltyPoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // ==================== NEW FEATURES ====================
    
    // Orders collection - customers read own, sellers read/update own, admins read all
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || 
                     isOwner(resource.data.sellerId) || 
                     isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isOwner(resource.data.sellerId) || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // Order notifications
    match /orderNotifications/{notificationId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isAdmin();
      allow write: if isAdmin();
    }

    // Reviews collection - customers create own, sellers/admins read and respond
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews (approved ones)
      allow create: if isAuthenticated() && 
                       (request.resource.data.userId == request.auth.uid ||
                        request.resource.data.customerId == request.auth.uid);
      allow update: if isOwner(resource.data.userId) || 
                       isOwner(resource.data.customerId) ||
                       isOwner(resource.data.sellerId) || 
                       isAdmin(); // For responses, flagging, and helpful count
      allow delete: if isAdmin();
    }

    // Seller ratings aggregated view
    match /sellerRatings/{sellerId} {
      allow read: if true; // Public
      allow write: if false; // Only Cloud Functions write
    }

    // Seller analytics
    match /sellerAnalytics/{sellerId}/daily/{dateKey} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    match /sellerPerformance/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Transactions ledger
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Seller wallet
    match /sellerWallet/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Withdrawal requests
    match /withdrawalRequests/{withdrawalId} {
      allow create: if isOwner(request.resource.data.sellerId);
      allow read: if isOwner(resource.data.sellerId) || isAdmin();
      allow update: if isAdmin() && resource.data.status != 'completed';
      allow delete: if isAdmin() && resource.data.status == 'rejected';
    }

    // Search analytics
    match /searchAnalytics/{analyticsId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow write: if false;
    }

    // Product search index (denormalized)
    match /productSearchIndex/{productId} {
      allow read: if true; // Public
      allow write: if false; // Only Cloud Functions
    }

    // Payment settings (admin only)
    match /paymentSettings/{document=**} {
      allow read: if isAdmin();
      allow write: if isLeadAdmin();
    }

    // Conversations for customer-seller chat
    match /conversations/{conversationId} {
      // Users can read conversations they are part of
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Users can create conversations where they are the customer
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid;
      // Participants can update conversation metadata
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Admins have full access
      allow read, write: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
        );
        // Participants can create messages with their own senderId
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          );
        // Admins have full access
        allow read, write: if isAdmin();
      }
    }

    // Service provider messaging (services page)
    match /service_messages/{conversationId} {
      // Users can read/write their own service conversations
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Admins (service providers) have full access
      allow read, write: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/service_messages/$(conversationId)).data.userId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          request.resource.data.senderUid == request.auth.uid &&
          get(/databases/$(database)/documents/service_messages/$(conversationId)).data.userId == request.auth.uid
        );
        allow read, write: if isAdmin();
      }
    }

    // Seller payment gateway settings
    match /sellerPaymentGateways/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId);
    }

    // ==================== PHASE 4: SCALE FEATURES ====================

    // Refunds collection - admin managed
    match /refunds/{refundId} {
      allow read: if isOwner(resource.data.buyerId) || 
                     isOwner(resource.data.sellerId) || 
                     isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Daily reports (platform analytics)
    match /dailyReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Platform earnings (commission tracking)
    match /platformEarnings/{earningId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Product views (for recommendations)
    match /productViews/{viewId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Shipping settings per seller
    match /sellerShipping/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin() || true; // Public for checkout
      allow write: if isOwner(sellerId);
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isOwner(resource.data.sellerId) || 
                     isOwner(resource.data.customerId) || 
                     isAdmin();
      allow create: if isOwner(request.resource.data.sellerId);
      allow update: if isOwner(resource.data.sellerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // AWB (Airway Bill) tracking
    match /awbTracking/{awbNumber} {
      allow read: if true; // Public tracking
      allow write: if false; // Only Cloud Functions
    }

    // ==================== PHASE 5: ENHANCED FEATURES ====================

    // Shared Wishlists - public share links
    match /sharedWishlists/{shareId} {
      // Anyone can read shared wishlists (for public links)
      allow read: if true;
      // Only the owner can create/update/delete
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Customer Support Tickets
    match /customerTickets/{ticketId} {
      // Customer can read their own tickets, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Customer can create tickets for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';
      // Customer can update (add messages), admins can update status
      allow update: if isOwner(resource.data.userId) || isAdmin();
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Return Requests (RMA)
    match /returnRequests/{requestId} {
      // Customer can read own, seller can read their products' returns, admins read all
      allow read: if isOwner(resource.data.customerId) || 
                     isOwner(resource.data.sellerId) || 
                     isAdmin();
      // Customer can create return requests
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Customer updates shipping, seller updates status, admin has full access
      allow update: if isOwner(resource.data.customerId) || 
                       isOwner(resource.data.sellerId) || 
                       isAdmin();
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Abandoned Carts - tracked for recovery
    match /abandonedCarts/{cartId} {
      // User can read own, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // System creates on cart abandonment
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      // Can be updated for recovery tracking
      allow update: if isOwner(resource.data.userId) || isAdmin();
      // Can be deleted when recovered
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Flash Sales - time-limited deals
    match /flashSales/{saleId} {
      // Public read for active sales
      allow read: if true;
      // Sellers can create their own flash sales
      allow create: if isAuthenticated() && 
        request.resource.data.sellerId == request.auth.uid &&
        sellerIsVerified();
      // Seller can update own sales, admins can update any
      allow update: if isOwner(resource.data.sellerId) || isAdmin();
      // Seller can delete own sales, admins can delete any
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    // Flash Sale Reservations - temporary stock holds
    match /flashSaleReservations/{reservationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{tokenId} {
      // User can read their own tokens
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // User can create/update their own tokens
      allow create, update: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      // User can delete their own tokens
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Notification Preferences
    match /notificationPreferences/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Topic Subscriptions for Push Notifications
    match /topicSubscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Recovery Discounts (for abandoned cart)
    match /recoveryDiscounts/{discountId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false; // Only Cloud Functions
      allow update: if isOwner(resource.data.userId); // Mark as used
      allow delete: if isAdmin();
    }

    // User Wishlists (main wishlist data)
    match /wishlists/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Chat typing indicators (ephemeral)
    match /typingIndicators/{conversationId} {
      allow read, write: if isAuthenticated();
    }

    // ═══ BUNDLE DEALS ═══
    match /bundles/{bundleId} {
      // Anyone can read active bundles (displayed on product/shop pages)
      allow read: if true;
      // Verified sellers can create bundles for their own products
      allow create: if sellerOwnsRequestData() && sellerIsVerified();
      // Seller can update/delete own bundles, admins have full access
      allow update: if (sellerOwnsData(resource.data) && sellerOwnsRequestData()) || isAdmin();
      allow delete: if sellerOwnsData(resource.data) || isAdmin();
    }

    // ═══ PRICE NEGOTIATIONS ═══
    match /negotiations/{negotiationId} {
      // Both participants can read their own negotiations
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Customers can create negotiations (must be the customer in the doc)
      allow create: if isAuthenticated() &&
        request.resource.data.customerId == request.auth.uid;
      // Both parties can update (for offers, status changes)
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Admins have full access
      allow read, write: if isAdmin();

      // Offers subcollection — each price proposal
      match /offers/{offerId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.sellerId == request.auth.uid
        );
        allow create: if isAuthenticated() &&
          request.resource.data.proposerId == request.auth.uid && (
            get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/negotiations/$(negotiationId)).data.sellerId == request.auth.uid
          );
        allow read, write: if isAdmin();
      }
    }

    // ═══ PRICE DROP ALERTS ═══
    match /priceAlerts/{alertId} {
      // Users can read their own alerts, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Authenticated users can create alerts for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Users can update their own alerts (edit target price, dismiss)
      allow update: if isOwner(resource.data.userId);
      // Users can delete their own alerts, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ═══ PRODUCT Q&A ═══
    match /productQuestions/{questionId} {
      // Anyone can read questions (public product Q&A)
      allow read: if true;
      // Authenticated users can create questions
      allow create: if isAuthenticated() &&
        request.resource.data.askedBy == request.auth.uid;
      // Question asker, product seller, and admins can update (add answers, mark helpful)
      allow update: if isAuthenticated();
      // Only admins and the question asker can delete
      allow delete: if isOwner(resource.data.askedBy) || isAdmin();
    }

    // ═══ REFERRAL PROGRAM ═══
    match /referralCodes/{userId} {
      // Anyone can look up referral codes (for validation during signup)
      allow read: if true;
      // Users can create/update their own referral code document
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      // Referrer can read their own referrals
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.refereeId == request.auth.uid
      );
      // Authenticated users can create referral records
      allow create: if isAuthenticated();
      // System/admin updates (mark completed, give rewards)
      allow update: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.refereeId == request.auth.uid
      ) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
