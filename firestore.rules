rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    
    // Admins collection - only admins can read, no writes from client
    match /admins/{email} {
      allow read: if isAuthenticated() && request.auth.token.email == email;
      allow write: if false; // Admins must be added manually via Firebase Console
    }
    
    // Users collection - users can read/write their own documents, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Admins can update user status
    }
    
    // Sellers collection - sellers can read/write their own documents
    match /sellers/{sellerId} {
      // Any authenticated user can check if they are a seller
      allow read: if isOwner(sellerId);
      allow write: if isOwner(sellerId);
      allow create: if isAuthenticated() && request.auth.uid == sellerId;
    }
    
    // Products collection - anyone can read, sellers can write their own
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && 
        (resource == null || resource.data.sellerId == request.auth.uid);
      allow create: if isAuthenticated();
      allow delete: if isAdmin(); // Admins can remove products
    }
    
    // Orders collection - admins can read all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || 
         resource.data.buyerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        resource.data.sellerId == request.auth.uid;
    }
    
    // Seller Services collection
    match /sellerServices/{sellerId} {
      allow read: if true;
      allow write: if isOwner(sellerId);
    }
    
    // Seller Verification collection - sellers can submit, admins can read/update
    match /sellerVerification/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create, update: if isOwner(sellerId);
      allow update: if isAdmin(); // Admins can approve/reject
    }
    
    // General read access for public data
    match /categories/{document=**} {
      allow read: if true;
    }
  }
}
