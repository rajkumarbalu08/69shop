rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function authEmail() {
      return isAuthenticated() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function normalizedEmail() {
      let email = authEmail();
      return email == '' ? '' : email.lower();
    }

    function adminRecordExists() {
      return isAuthenticated() && (
        (normalizedEmail() != '' && exists(/databases/$(database)/documents/admins/$(normalizedEmail()))) ||
        (authEmail() != '' && authEmail() != normalizedEmail() && exists(/databases/$(database)/documents/admins/$(authEmail())))
      );
    }

    function isAdminUserProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin';
    }

    function isLeadAdmin() {
      return normalizedEmail() == 'rajkumarbalu81@gmail.com';
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isLeadAdmin() || adminRecordExists() || isAdminUserProfile();
    }

    function sellerOwnsData(data) {
      return isAuthenticated() && data.sellerId == request.auth.uid;
    }

    function sellerOwnsRequestData() {
      return isAuthenticated() && request.resource != null &&
        request.resource.data.sellerId == request.auth.uid;
    }

    function sellerCreatesAdminNotification() {
      return sellerOwnsRequestData() &&
        request.resource.data.audience == 'admin' &&
        request.resource.data.type == 'support' &&
        request.resource.data.ticketId != null;
    }

    function sellerIsVerified() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.verified == true ||
          get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved' ||
          (
            exists(/databases/$(database)/documents/sellerVerification/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/sellerVerification/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    function notificationAudienceAllowed(audience) {
      return audience == 'all' ||
        audience == 'seller' ||
        audience == 'buyer' ||
        audience == ('user:' + request.auth.uid) ||
        audience == ('seller:' + request.auth.uid) ||
        (audience == 'admin' && isAdmin());
    }
    
    // Admins collection - only admins can read, no writes from client
    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if isLeadAdmin();
    }

    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isLeadAdmin();
    }
    
    // Users collection - users can read/write their own documents, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Admins can update user status
    }
    
    // Sellers collection - sellers can read/write their own documents
    function sellerOwnerSafeUpdate(sellerId) {
      return isOwner(sellerId) && resource != null &&
        !request.resource.data.diff(resource.data).changedKeys()
          .hasAny(['verified', 'status', 'approvedAt', 'approvedBy', 'approvalNotes']);
    }

    match /sellers/{sellerId} {
      // Any authenticated user can check if they are a seller
      allow read: if isOwner(sellerId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == sellerId &&
        (!request.resource.data.keys().hasAny(['verified', 'status']) || request.resource.data.verified == false);
      allow update: if isAdmin() || sellerOwnerSafeUpdate(sellerId);
      allow delete: if isAdmin();
    }
    
    // Products collection - anyone can read, sellers can write their own
    match /products/{productId} {
      allow read: if true;
      allow create: if sellerOwnsRequestData() && sellerIsVerified();
      allow update: if ((sellerOwnsData(resource.data) && sellerOwnsRequestData() && sellerIsVerified()) || isAdmin());
      allow delete: if sellerOwnsData(resource.data) || isAdmin();
    }
    
    // Orders collection - admins can read all orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || 
         resource.data.buyerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        resource.data.sellerId == request.auth.uid;
    }
    
    // Seller Services collection
    match /sellerServices/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId) || isAdmin();
    }
    
    // Seller Verification collection - sellers can submit, admins can read/update
    match /sellerVerification/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create, update: if isOwner(sellerId);
      allow update: if isAdmin(); // Admins can approve/reject
    }

    // Service verification submissions
    match /serviceVerifications/{submissionId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsRequestData();
      allow update, delete: if isAdmin() || (sellerOwnsData(resource.data) && !request.resource.data.keys().hasAny(['status', 'adminNote', 'reviewerEmail', 'reviewedAt']));
    }

    // Seller support tickets
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsRequestData() && 
        request.resource.data.status == 'open' &&
        request.resource.data.subject != null &&
        request.resource.data.description != null;
      allow update: if isAdmin() || (sellerOwnsData(resource.data) && !request.resource.data.keys().hasAny(['status', 'adminNote', 'adminEmail', 'lastActor']));
      allow delete: if isAdmin();
    }

    // Notifications collection - targeted notifications for users/sellers/admins
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && notificationAudienceAllowed(resource.data.audience);
      allow create: if isAdmin() || sellerCreatesAdminNotification();
      allow update, delete: if isAdmin();
    }

    match /platformSettings/{docId} {
      allow read: if isAdmin() || isLeadAdmin();
      allow write: if isLeadAdmin();
    }

    // Transactions collection - sellers and admins only
    match /transactions/{transactionId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow write: if false; // Managed via backend processes
    }

    // Withdrawals collection - sellers can create/read their own, admins manage
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || sellerOwnsData(resource.data);
      allow create: if sellerOwnsData(request.resource.data);
      allow update: if isAdmin() || sellerOwnsData(resource.data);
    }
    
    // General read access for public data
    match /categories/{document=**} {
      allow read: if true;
    }

    // ==================== NEW FEATURES ====================
    
    // Orders collection - customers read own, sellers read/update own, admins read all
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.customerId) || 
                     isOwner(resource.data.sellerId) || 
                     isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isOwner(resource.data.sellerId);
      allow delete: if isAdmin();
    }

    // Order notifications
    match /orderNotifications/{notificationId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isAdmin();
      allow write: if isAdmin();
    }

    // Reviews collection - customers create own, sellers/admins read and respond
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews
      allow create: if isOwner(request.resource.data.customerId) && 
                       isAuthenticated();
      allow update: if isOwner(resource.data.customerId) || 
                       isOwner(resource.data.sellerId) || 
                       isAdmin(); // For responses and flagging
      allow delete: if isAdmin();
    }

    // Seller ratings aggregated view
    match /sellerRatings/{sellerId} {
      allow read: if true; // Public
      allow write: if false; // Only Cloud Functions write
    }

    // Seller analytics
    match /sellerAnalytics/{sellerId}/daily/{dateKey} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    match /sellerPerformance/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Transactions ledger
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Seller wallet
    match /sellerWallet/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if false; // Only Cloud Functions
    }

    // Withdrawal requests
    match /withdrawalRequests/{withdrawalId} {
      allow create: if isOwner(request.resource.data.sellerId);
      allow read: if isOwner(resource.data.sellerId) || isAdmin();
      allow update: if isAdmin() && resource.data.status != 'completed';
      allow delete: if isAdmin() && resource.data.status == 'rejected';
    }

    // Search analytics
    match /searchAnalytics/{analyticsId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow write: if false;
    }

    // Product search index (denormalized)
    match /productSearchIndex/{productId} {
      allow read: if true; // Public
      allow write: if false; // Only Cloud Functions
    }

    // Payment settings (admin only)
    match /paymentSettings/{document=**} {
      allow read: if isAdmin();
      allow write: if isLeadAdmin();
    }

    // Conversations for customer-seller chat
    match /conversations/{conversationId} {
      // Users can read conversations they are part of
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Users can create conversations where they are the customer
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid;
      // Participants can update conversation metadata
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // Admins have full access
      allow read, write: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
        );
        // Participants can create messages with their own senderId
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          );
        // Admins have full access
        allow read, write: if isAdmin();
      }
    }

    // Seller payment gateway settings
    match /sellerPaymentGateways/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId);
    }
  }
}
