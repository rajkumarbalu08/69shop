{
  "name": "shop-mail-functions",
  "description": "Firebase Cloud Functions for transactional mail at 69Shop.in",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "lint": "eslint --ext .js . || true",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "encrypt:mail": "node scripts/encrypt-mail-config.js",
    "audit:admins": "node scripts/admin-audit.js",
    "audit:admins:fix": "node scripts/admin-audit.js --fix",
    "fix:seller-status": "node scripts/normalize-seller-statuses.js",
    "fix:seller-status:apply": "node scripts/normalize-seller-statuses.js --apply",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.9.0",
    "nodemailer": "^6.9.8"
  }
}
