rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminEmailList() {
      return ['rajkumarbalu81@gmail.com'];
    }

    function isAdminUser() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && lower(request.auth.token.email) in adminEmailList())
      );
    }

    function canManageResource(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdminUser());
    }

    // Allow authenticated users to read any file
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Product images - sellers can upload to their folder
    match /products/{userId}/{fileName} {
      allow write: if canManageResource(userId);
      allow read: if true;
    }
    
    // Profile images
    match /profiles/{userId}/{fileName} {
      allow write: if canManageResource(userId);
      allow read: if true;
    }

    // Seller logos displayed across dashboards
    match /seller-logos/{userId}/{fileName} {
      allow write: if canManageResource(userId);
      allow read: if true;
    }

    // Legacy logo uploads without filename segment
    match /seller-logos/{userId} {
      allow write: if canManageResource(userId);
      allow read: if true;
    }
    
    // Service images - for service providers
    match /services/{userId}/{fileName} {
      allow write: if canManageResource(userId);
      allow read: if true;
    }
    
    // Seller verification documents - private
    match /seller-documents/{userId}/{fileName} {
      allow write: if canManageResource(userId);
      allow read: if canManageResource(userId);
    }
  }
}
